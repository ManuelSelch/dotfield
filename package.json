{
  "name": "dotfield",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && npx vercel --prod",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:pwa": "npm run build && playwright test --config playwright.pwa.config.ts"
  },
  "dependencies": {
    "@blockly/block-shareable-procedures": "13.4.0",
    "@mantine/core": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@tabler/icons-react": "^3.49.0",
    "blockly": "13.4.0",
    "mistreevous": "^4.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
